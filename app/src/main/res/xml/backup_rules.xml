<?xml version="1.0" encoding="utf-8"?>
<!-- For Android 11 and older (the data extraction rules cover 12 and newer): nothing is backed up, see there why. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
